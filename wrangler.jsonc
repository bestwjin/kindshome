{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "kindshome",
  "account_id": "4afa470f86de21295313b1debdbb0d3f",
  "compatibility_date": "2025-07-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "routes": [
    { "pattern": "kinds.kr", "custom_domain": true },
    { "pattern": "www.kinds.kr", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Keep exact .html paths (needed for Naver Search Advisor verification files).
    "html_handling": "none"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kindshome"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "thekinds@naver.com",
      "allowed_sender_addresses": ["consult@contact.kinds.kr"]
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  "kv_namespaces": [
    {
      "binding": "VISITS",
      "id": "137bf168a4044867b978ceeee9381c6c"
    }
  ]
}
